#!/usr/bin/env bash
# BEGIN AETHIEA_MARKER_RESOLVE
_aeth_resolve_root() {
  local p="${AETHIEA_ROOT:-${AETH_ROOT:-${AETHIEA:-${AETHIEAOPSYS:-$(pwd -P)}}}}"
  if [ -n "$p" ] && [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  p="$(pwd -P)"
  while [ "$p" != "/" ] && [ ! -f "$p/.aeth_root" ]; do p="$(dirname "$p")"; done
  if [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  for p in /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -f "$p/.aeth_root" ] && { (cd "$p" && pwd -P); return; }
  done
  return 1
}
AETHIEA_ROOT="$(_aeth_resolve_root)" || { echo "NO_AETH_ROOT_FOUND"; exit 1; }
export AETHIEA_ROOT AETH_ROOT="$AETHIEA_ROOT" AETHIEA="$AETHIEA_ROOT" AETHIEAOPSYS="$AETHIEA_ROOT"
# END AETHIEA_MARKER_RESOLVE

set -u

ROOT="${AETHIEA:-$AETHIEA_ROOT}"
PUB="$ROOT/CONFIG/ssh/aethiea_operator.pub"
INV="$ROOT/CONFIG/ssh/inventory/ssh_targets.tsv"

mkdir -p "$ROOT/SERVICES/ssh/receipts"

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="/tmp/aessh_push_key_${HOSTNAME}_${STAMP}.txt"

{
  echo "=== AESSH PUBLIC KEY PUSH ==="
  date -u +%FT%TZ
  hostname
  whoami

  echo
  echo "=== PUBLIC KEY ==="
  ls -l "$PUB"
  sha256sum "$PUB"
  cat "$PUB"

  echo
  echo "=== INVENTORY ==="
  cat -te "$INV"

  echo
  echo "=== PUSH RESULTS ==="

  while IFS=$'\t' read -r label user host port; do
    [[ -z "${label:-}" ]] && continue
    [[ "$label" =~ ^# ]] && continue
    [[ -z "${user:-}" || -z "${host:-}" ]] && continue

    port="${port:-22}"

    echo
    echo "--- $label :: $user@$host:$port"

    ssh-copy-id \
      -i "$PUB" \
      -p "$port" \
      -o StrictHostKeyChecking=accept-new \
      "$user@$host" \
      && echo "OK $label" \
      || echo "FAIL $label"
  done < "$INV"

} | tee "$OUT"

for root in "$AETHIEA_ROOT" /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS"; do
  [ -d "$root" ] || continue
  mkdir -p "$root/SERVICES/ssh/receipts"
  cp "$OUT" "$root/SERVICES/ssh/receipts/"
done

sha256sum "$OUT"
