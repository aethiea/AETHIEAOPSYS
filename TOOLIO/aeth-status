#!/usr/bin/env bash

aeth_valid_body() {
  [ -n "${1:-}" ] || return 1
  [ -d "$1" ] || return 1
  [ -f "$1/.aeth_root" ] || return 1
  [ -f "$1/STATUS.md" ] || return 1
  [ ! -f "$1/AE320GB_HEAVY_BODY" ] || return 1
  [ ! -f "$1/.aeth_heavy_body" ] || return 1
}

aeth_resolve_body() {
  local c d r

  for c in "${AETHIEA:-}" "${AETH_ROOT:-}" "${AETHIEA_ROOT:-}" "$PWD"; do
    [ -n "$c" ] || continue
    d="$c"
    while [ "$d" != "/" ]; do
      if aeth_valid_body "$d"; then
        printf '%s\n' "$d"
        return 0
      fi
      d="$(dirname "$d")"
    done
  done

  for r in /mnt/[a-z]/AETHIEAOPSYS; do
    if aeth_valid_body "$r"; then
      printf '%s\n' "$r"
      return 0
    fi
  done

  return 1
}

AETHIEA="$(aeth_resolve_body)" || {
  echo "STOP: AETHIEAOPSYS body not found by markers"
  exit 1
}

export AETHIEA
export AETH_ROOT="$AETHIEA"
export AETHIEA_ROOT="$AETHIEA"
export AETHIEA_MODE="${AETHIEA_MODE:-USB_NATIVE_ROUTED}"
export AETHIEA_SURFACE="${AETHIEA_SURFACE:-$(hostname)}"

if [ -f "$AETHIEA/ENV/SHELL/aethiea_env.sh" ]; then
  . "$AETHIEA/ENV/SHELL/aethiea_env.sh"
  export AETHIEA="$AETH_ROOT"
  export AETH_ROOT="$AETHIEA"
  export AETHIEA_ROOT="$AETHIEA"
fi

echo "=== AETHIEA SURFACE STATUS ==="
echo "HOST      -> $(hostname)"
echo "USER      -> $(whoami)"
echo "SURFACE   -> $AETHIEA_SURFACE"
echo "MODE      -> $AETHIEA_MODE"
echo "ROOT      -> $AETHIEA"
echo "AETH_ROOT -> $AETH_ROOT"
echo "OLLAMA    -> ${OLLAMA_MODELS:-UNSET}"
echo "HF_HOME   -> ${HF_HOME:-UNSET}"

test -d "$AETHIEA" && echo "ROOT DIR  -> OK" || echo "ROOT DIR  -> FAIL"
test -f "$AETHIEA/.aeth_root" && echo "ROOT MARK -> OK" || echo "ROOT MARK -> FAIL"

echo "AETH CMD  -> $(command -v aeth || echo FAIL)"
aeth status || true
aeusb-route-check || true

echo "=== END STATUS ==="
