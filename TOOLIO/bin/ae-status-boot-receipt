#!/usr/bin/env bash
set -u

STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="/tmp/ae_status_BOOT_RUBIII_$STAMP.txt"

if ! command -v ae-status >/dev/null 2>&1; then
  echo "ae-status not found" | tee "$OUT"
  exit 1
fi

ae-status | tee "$OUT"

for root in "${AETHIEA:-${AETH_ROOT:-$(pwd -P)}}"; do
  [ -d "$root" ] || continue
  mkdir -p "$root/DATA/STATUS/receipts" "$root/TOOLIO/bin"
  cp "${AETHIEA:-${AETH_ROOT:-$(pwd -P)}}/TOOLIO/bin/ae-status" "$root/TOOLIO/bin/ae-status" 2>/dev/null || true
  cp "$OUT" "$root/DATA/STATUS/receipts/"
done

sha256sum "$OUT" | tee -a "${AETHIEA:-${AETH_ROOT:-$(pwd -P)}}/LOGS/BOOT/aevps_startup.log"
