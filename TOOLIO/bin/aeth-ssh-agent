#!/usr/bin/env bash
set -euo pipefail

KEY="${1:-$HOME/.ssh/id_ed25519}"

echo "=== AETHIEA SSH AGENT ==="

if [ -z "${SSH_AUTH_SOCK:-}" ]; then
  echo "Starting ssh-agent..."
  eval "$(ssh-agent -s)"
else
  echo "ssh-agent socket already present:"
  echo "$SSH_AUTH_SOCK"
fi

echo
echo "Checking loaded keys..."

if ssh-add -l 2>/dev/null | grep -q "$(ssh-keygen -lf "$KEY" | awk '{print $2}')"; then
  echo "Key already loaded:"
  echo "$KEY"
else
  echo "Loading key:"
  echo "$KEY"
  ssh-add "$KEY"
fi

echo
echo "Loaded keys:"
ssh-add -l
