#!/usr/bin/env bash
set -euo pipefail

AEUSB_ROOT="${AEUSB_ROOT:-/mnt/h/AETHIEAOPSYS}"
AEXHD_ROOT="${AEXHD_ROOT:-/mnt/i/AETHIEAOPSYS}"
HUSH_ROOT="$AEXHD_ROOT/DATA/MEMORY/HUSH"
VAULT="$HUSH_ROOT/vault"
RUNTIME="$HUSH_ROOT/runtime"
AEVPS_IP="${AEVPS_IP:-5.161.63.237}"
AEVPS_USER="${AEVPS_USER:-root}"

usage() {
  cat <<USAGE
hush-ae status
hush-ae seal <name>        # encrypt /dev/shm/<name>.env into AEXHD vault
hush-ae push-aevps <name>  # decrypt vault and send runtime copy to AEVPS over SSH
hush-ae list
USAGE
}

cmd="${1:-}"
name="${2:-}"

case "$cmd" in
  status)
    echo "AETHIEA HUSH STATUS"
    echo "AEUSB_ROOT=$AEUSB_ROOT"
    echo "AEXHD_ROOT=$AEXHD_ROOT"
    echo "VAULT=$VAULT"
    echo "RUNTIME=$RUNTIME"
    echo "AEVPS=$AEVPS_USER@$AEVPS_IP"
    [ -d "$VAULT" ] && echo "VAULT_OK" || echo "VAULT_MISSING"
    [ -d "$RUNTIME" ] && echo "RUNTIME_OK" || echo "RUNTIME_MISSING"
    ;;
  list)
    find "$VAULT" -maxdepth 1 -type f -name '*.env.gpg' -printf '%f\n' 2>/dev/null | sed 's/\.env\.gpg$//' || true
    ;;
  seal)
    [ -n "$name" ] || { usage; exit 2; }
    src="/dev/shm/${name}.env"
    dest="$VAULT/${name}.env.gpg"
    [ -f "$src" ] || {
      echo "MISSING_MEMORY_FILE=$src"
      echo "Create it with: nano $src"
      exit 1
    }
    mkdir -p "$VAULT"
    chmod 700 "$VAULT"
    gpg --symmetric --cipher-algo AES256 --output "$dest" "$src"
    chmod 600 "$dest"
    sha256sum "$dest" > "$dest.sha256"
    rm -f "$src"
    echo "SEALED=$dest"
    echo "SHA=$dest.sha256"
    echo "PLAINTEXT_REMOVED_FROM_DEV_SHM"
    ;;
  push-aevps)
    [ -n "$name" ] || { usage; exit 2; }
    src="$VAULT/${name}.env.gpg"
    [ -f "$src" ] || { echo "NO_SUCH_VAULT_SECRET=$src"; exit 1; }
    ssh "$AEVPS_USER@$AEVPS_IP" 'mkdir -p /opt/AETHIEAOPSYS/HUSH/runtime && chmod 700 /opt/AETHIEAOPSYS/HUSH /opt/AETHIEAOPSYS/HUSH/runtime'
    gpg --decrypt "$src" | ssh "$AEVPS_USER@$AEVPS_IP" "cat > /opt/AETHIEAOPSYS/HUSH/runtime/${name}.env && chmod 600 /opt/AETHIEAOPSYS/HUSH/runtime/${name}.env"
    echo "PUSHED_TO_AEVPS=/opt/AETHIEAOPSYS/HUSH/runtime/${name}.env"
    ;;
  *)
    usage
    exit 2
    ;;
esac
