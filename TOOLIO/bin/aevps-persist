#!/usr/bin/env bash
# BEGIN AETHIEA_MARKER_RESOLVE
_aeth_resolve_root() {
  local p="${AETHIEA_ROOT:-${AETH_ROOT:-${AETHIEA:-${AETHIEAOPSYS:-$(pwd -P)}}}}"
  if [ -n "$p" ] && [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  p="$(pwd -P)"
  while [ "$p" != "/" ] && [ ! -f "$p/.aeth_root" ]; do p="$(dirname "$p")"; done
  if [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  for p in /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -f "$p/.aeth_root" ] && { (cd "$p" && pwd -P); return; }
  done
  return 1
}
AETHIEA_ROOT="$(_aeth_resolve_root)" || { echo "NO_AETH_ROOT_FOUND"; exit 1; }
export AETHIEA_ROOT AETH_ROOT="$AETHIEA_ROOT" AETHIEA="$AETHIEA_ROOT" AETHIEAOPSYS="$AETHIEA_ROOT"
# END AETHIEA_MARKER_RESOLVE

set -euo pipefail

ROOT="$AETHIEA_ROOT"

AEVPS_NAME="${AEVPS_NAME:-aevps-001}"
AEVPS_IP="${AEVPS_IP:-5.161.63.237}"
AEVPS_USER="${AEVPS_USER:-root}"
AEVPS_TUNNEL_ID="${AEVPS_TUNNEL_ID:-8b52d381-a5e5-464a-a5cf-67951b475be0}"

SECRET_DIR="$HOME/.config/aethiea/secrets"
HCLOUD_SECRET="$SECRET_DIR/hcloud.env"

mkdir -p \
  "$ROOT/TOOLIO/bin" \
  "$ROOT/TOOLIO/hcloud" \
  "$ROOT/TOOLIO/cloudflared" \
  "$ROOT/DATA/HCLOUD" \
  "$ROOT/DATA/CLOUDFLARED" \
  "$ROOT/DATA/MEMORY/REGISTRY" \
  "$ROOT/LOGS/HCLOUD" \
  "$ROOT/LOGS/CLOUDFLARED" \
  "$SECRET_DIR" \
  "$HOME/.ssh" \
  "$HOME/.local/bin" \
  "$HOME/.config/systemd/user"

chmod 700 "$SECRET_DIR" "$HOME/.ssh"

echo "=== AEVPS PERSISTENCE REPAIR ==="
echo "Root: $ROOT"
echo "Server: $AEVPS_NAME"
echo "IP: $AEVPS_IP"
echo "Tunnel: $AEVPS_TUNNEL_ID"
echo

if [ ! -f "$HCLOUD_SECRET" ]; then
  echo "No hcloud secret file found."
  echo "Paste the NEW ROTATED Hetzner token into this terminal only."
  echo "Do not paste it into chat, Git, logs, DATA, or registry files."
  read -rsp "HCLOUD_TOKEN: " NEW_HCLOUD_TOKEN
  echo
  NEW_HCLOUD_TOKEN="$(printf '%s' "$NEW_HCLOUD_TOKEN" | tr -d '\r\n[:space:]')"

  cat > "$HCLOUD_SECRET" <<EOF
export HCLOUD_TOKEN='$NEW_HCLOUD_TOKEN'
EOF

  chmod 600 "$HCLOUD_SECRET"
  echo "Wrote host-local hcloud secret: $HCLOUD_SECRET"
else
  chmod 600 "$HCLOUD_SECRET"
  echo "Using existing host-local hcloud secret: $HCLOUD_SECRET"
fi

cat > "$ROOT/TOOLIO/hcloud/hcloud-ae" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

ROOT="$AETHIEA_ROOT"
LOG_DIR="$ROOT/LOGS/HCLOUD"
SECRET_FILE="$HOME/.config/aethiea/secrets/hcloud.env"

mkdir -p "$LOG_DIR"

if [ -f "$SECRET_FILE" ]; then
  # shellcheck disable=SC1090
  source "$SECRET_FILE"
fi

if [ -z "${HCLOUD_TOKEN:-}" ]; then
  echo "HCLOUD_TOKEN missing. Load ~/.config/aethiea/secrets/hcloud.env or export HCLOUD_TOKEN." >&2
  exit 1
fi

echo "$(date -u +%FT%TZ) HCLOUD ROUTE → hcloud $*" >> "$LOG_DIR/hcloud.log"
exec hcloud "$@"
EOF

chmod +x "$ROOT/TOOLIO/hcloud/hcloud-ae"
ln -sf "$ROOT/TOOLIO/hcloud/hcloud-ae" "$HOME/.local/bin/hcloud-ae"

cat > "$ROOT/TOOLIO/cloudflared/cloudflared-ae" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

ROOT="$AETHIEA_ROOT"
LOG_DIR="$ROOT/LOGS/CLOUDFLARED"

mkdir -p "$LOG_DIR"

echo "$(date -u +%FT%TZ) CLOUDFLARED ROUTE → cloudflared $*" >> "$LOG_DIR/cloudflared.log"
exec cloudflared "$@"
EOF

chmod +x "$ROOT/TOOLIO/cloudflared/cloudflared-ae"
ln -sf "$ROOT/TOOLIO/cloudflared/cloudflared-ae" "$HOME/.local/bin/cloudflared-ae"

cat > "$ROOT/TOOLIO/cloudflared/run-aevps-tunnel" <<EOF
#!/usr/bin/env bash
set -euo pipefail

ROOT="$AETHIEA_ROOT"
LOG_DIR="\$ROOT/LOGS/CLOUDFLARED"
TUNNEL_ID="$AEVPS_TUNNEL_ID"

mkdir -p "\$LOG_DIR"

echo "\$(date -u +%FT%TZ) AEVPS/CLOUDFLARED tunnel start requested → \$TUNNEL_ID" >> "\$LOG_DIR/cloudflared.log"
exec cloudflared tunnel run "\$TUNNEL_ID"
EOF

chmod +x "$ROOT/TOOLIO/cloudflared/run-aevps-tunnel"
ln -sf "$ROOT/TOOLIO/cloudflared/run-aevps-tunnel" "$HOME/.local/bin/aevps-tunnel"

cat > "$ROOT/TOOLIO/bin/aevps-registry-write" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

ROOT="$AETHIEA_ROOT"
AEVPS_NAME="${AEVPS_NAME:-aevps-001}"
AEVPS_IP="${AEVPS_IP:-5.161.63.237}"
AEVPS_TUNNEL_ID="${AEVPS_TUNNEL_ID:-8b52d381-a5e5-464a-a5cf-67951b475be0}"

REG="$ROOT/DATA/MEMORY/REGISTRY/aevps_current.md"
mkdir -p "$ROOT/DATA/MEMORY/REGISTRY"

cat > "$REG" <<REGEOF
# AEVPS CURRENT REGISTRY

Timestamp: $(date -u +%FT%TZ)
Authority Body: ${AETHIEA_ROOT}
Host Surface: RUBIII
Provider: Hetzner Cloud

## Server
Name: $AEVPS_NAME
IPv4: $AEVPS_IP
SSH Host Alias: $AEVPS_NAME

## Cloudflare Tunnel
Tunnel ID: $AEVPS_TUNNEL_ID
Tunnel Launcher: ~/.local/bin/aevps-tunnel
Service: ~/.config/systemd/user/aevps-tunnel.service

## Doctrine
Operator governs.
AEUSB defines.
RUBIII executes.
Hetzner holds uptime.
Cloudflare routes edge.
Corpus proves.
No host owns.

## Credential Rule
HCLOUD token is host-local and must not be stored in this registry.
SSH private key remains host-local.
AEUSB carries wrappers, routes, receipts, and proof.

## Commands
hcloud-ae location list
hcloud-ae server describe $AEVPS_NAME
aevps-status
ssh $AEVPS_NAME
systemctl --user status aevps-tunnel.service
REGEOF

echo "$REG"
EOF

chmod +x "$ROOT/TOOLIO/bin/aevps-registry-write"
ln -sf "$ROOT/TOOLIO/bin/aevps-registry-write" "$HOME/.local/bin/aevps-registry-write"

cat > "$ROOT/TOOLIO/bin/aevps-status" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

ROOT="$AETHIEA_ROOT"
AEVPS_NAME="${AEVPS_NAME:-aevps-001}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"

mkdir -p "$ROOT/DATA/HCLOUD" "$ROOT/DATA/CLOUDFLARED" "$ROOT/LOGS/HCLOUD" "$ROOT/LOGS/CLOUDFLARED"

echo "=== AEVPS STATUS ==="
echo "Time: $(date -u +%FT%TZ)"
echo "Root: $ROOT"
echo "Server: $AEVPS_NAME"
echo

echo "[HCLOUD]"
if hcloud-ae location list > "$ROOT/DATA/HCLOUD/locations_${STAMP}.txt"; then
  echo "hcloud auth: OK"
else
  echo "hcloud auth: FAILED"
fi
echo

echo "[SERVER DESCRIBE]"
hcloud-ae server describe "$AEVPS_NAME" | tee "$ROOT/DATA/HCLOUD/server_describe_${AEVPS_NAME}_${STAMP}.txt" || true
echo

echo "[SERVER LIST]"
hcloud-ae server list | tee "$ROOT/DATA/HCLOUD/servers_${STAMP}.txt" || true
echo

echo "[FIREWALL LIST]"
hcloud-ae firewall list | tee "$ROOT/DATA/HCLOUD/firewalls_${STAMP}.txt" || true
echo

echo "[CLOUDFLARED TUNNELS]"
cloudflared-ae tunnel list | tee "$ROOT/DATA/CLOUDFLARED/tunnels_${STAMP}.txt" || true
echo

echo "[TUNNEL SERVICE]"
systemctl --user status aevps-tunnel.service --no-pager || true
echo

echo "[SSH TEST]"
ssh -o BatchMode=yes -o ConnectTimeout=5 "$AEVPS_NAME" 'echo AEVPS_SSH_OK && hostname && uname -a' || true
EOF

chmod +x "$ROOT/TOOLIO/bin/aevps-status"
ln -sf "$ROOT/TOOLIO/bin/aevps-status" "$HOME/.local/bin/aevps-status"

if ! grep -q "Host $AEVPS_NAME" "$HOME/.ssh/config" 2>/dev/null; then
  cat >> "$HOME/.ssh/config" <<EOF

Host $AEVPS_NAME
  HostName $AEVPS_IP
  User $AEVPS_USER
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
EOF
fi

chmod 600 "$HOME/.ssh/config"

cat > "$HOME/.config/systemd/user/aevps-tunnel.service" <<EOF
[Unit]
Description=AETHIEA AEVPS Cloudflared Tunnel
After=network-online.target

[Service]
Type=simple
ExecStart=$HOME/.local/bin/aevps-tunnel
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload || true
  systemctl --user enable aevps-tunnel.service || true
fi

aevps-registry-write >/dev/null

echo "$(date -u +%FT%TZ) AEVPS PERSISTENCE REPAIR APPLIED → $AEVPS_NAME $AEVPS_IP tunnel=$AEVPS_TUNNEL_ID" \
  | tee -a "$ROOT/LOGS/HCLOUD/hcloud.log" \
  | tee -a "$ROOT/LOGS/CLOUDFLARED/cloudflared.log" >/dev/null

echo
echo "=== REPAIR COMPLETE ==="
echo "Commands now available:"
echo "  hcloud-ae location list"
echo "  hcloud-ae server describe $AEVPS_NAME"
echo "  ssh $AEVPS_NAME"
echo "  aevps-status"
echo "  systemctl --user start aevps-tunnel.service"
echo "  systemctl --user status aevps-tunnel.service"
echo
echo "Next:"
echo "  systemctl --user start aevps-tunnel.service"
echo "  aevps-status"
