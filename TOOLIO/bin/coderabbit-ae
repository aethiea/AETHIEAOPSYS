#!/usr/bin/env bash
set -euo pipefail

ROOT="$(aeusb-root)" || {
  echo "CODERABBIT_AE: AEUSB authority root not found" >&2
  exit 1
}

CR_BIN="${CODERABBIT_BIN:-$HOME/.local/bin/coderabbit}"
AETH_GIT_DIR="${AETHIEA_GIT_DIR:-$HOME/.aethiea_git/AETHIEAOPSYS.git}"

if [ ! -x "$CR_BIN" ]; then
  echo "CODERABBIT_BIN_MISSING=$CR_BIN" >&2
  exit 1
fi

if [ ! -d "$AETH_GIT_DIR" ]; then
  echo "AETHIEA_GIT_DIR_MISSING=$AETH_GIT_DIR" >&2
  exit 2
fi

export GIT_DIR="$AETH_GIT_DIR"
export GIT_WORK_TREE="$ROOT"

cd "$ROOT"
exec "$CR_BIN" "$@"
