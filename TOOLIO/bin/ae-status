#!/usr/bin/env bash
# BEGIN AETHIEA_MARKER_RESOLVE
_aeth_resolve_root() {
  local p="${AETHIEA_ROOT:-${AETH_ROOT:-${AETHIEA:-${AETHIEAOPSYS:-$(pwd -P)}}}}"
  if [ -n "$p" ] && [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  p="$(pwd -P)"
  while [ "$p" != "/" ] && [ ! -f "$p/.aeth_root" ]; do p="$(dirname "$p")"; done
  if [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  for p in /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -f "$p/.aeth_root" ] && { (cd "$p" && pwd -P); return; }
  done
  return 1
}
AETHIEA_ROOT="$(_aeth_resolve_root)" || { echo "NO_AETH_ROOT_FOUND"; exit 1; }
export AETHIEA_ROOT AETH_ROOT="$AETHIEA_ROOT" AETHIEA="$AETHIEA_ROOT" AETHIEAOPSYS="$AETHIEA_ROOT"
# END AETHIEA_MARKER_RESOLVE

set -u

ROOT="$AETHIEA_ROOT"

echo "=== AETHIEAOPSYS STATUS ==="
date -u +%FT%TZ
hostname
whoami

echo
echo "=== ROOTS ==="
for root in "$AETHIEA_ROOT" /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS"; do
  printf "%-38s " "$root"
  [ -d "$root" ] && echo "PRESENT" || echo "MISSING"
done

echo
echo "=== AEVPS ==="
systemctl --user is-enabled aevps-startup.service 2>/dev/null | sed 's/^/aevps-startup enabled: /' || true
systemctl --user is-enabled aevps-tunnel.service 2>/dev/null | sed 's/^/aevps-tunnel enabled:  /' || true
systemctl --user is-active aevps-tunnel.service 2>/dev/null | sed 's/^/aevps-tunnel active:   /' || true
[ -f "$ROOT/DATA/BOOT/AEVPS_STARTUP_STATUS.md" ] && cat "$ROOT/DATA/BOOT/AEVPS_STARTUP_STATUS.md"

echo
echo "=== CALLABLE TOOLS ==="
for cmd in hcloud cloudflared ssh juicefs fabric prometheus grafana grafana-server redis-server psql docker jq yq; do
  if command -v "$cmd" >/dev/null 2>&1; then
    echo "FOUND   $cmd -> $(command -v "$cmd")"
  else
    echo "MISSING $cmd"
  fi
done

echo
echo "=== AE-CARRIED TOOL RESOLUTION ==="
for cmd in cloudflared fabric juicefs; do
  if command -v "$cmd" >/dev/null 2>&1; then
    echo "$cmd => $(readlink -f "$(command -v "$cmd")")"
  fi
done

echo
echo "=== OBSERVABILITY ==="
if [ -f "$ROOT/CONFIG/observability/observability_modes.json" ]; then
  jq -r '.lane + " / " + .status' "$ROOT/CONFIG/observability/observability_modes.json" 2>/dev/null || cat "$ROOT/CONFIG/observability/observability_modes.json"
  sha256sum "$ROOT/CONFIG/observability/observability_modes.json"
fi

echo
echo "=== AESOFT AUDIT ==="
aesoft-audit 2>/dev/null || echo "aesoft-audit not callable"
