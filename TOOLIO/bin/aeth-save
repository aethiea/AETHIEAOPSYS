#!/usr/bin/env bash
set -euo pipefail

AEUSB="/mnt/h/AETHIEAOPSYS"

if [ "${1:-}" = "" ]; then
  echo "Usage:"
  echo '  aeth-save "Commit message"'
  echo '  aeth-save "Commit message" PATH1 PATH2'
  exit 1
fi

MSG="$1"
shift || true

run_aegit() {
  local cmd="cd $(printf '%q' "$AEUSB"); aegit"
  local arg
  for arg in "$@"; do
    cmd="$cmd $(printf '%q' "$arg")"
  done
  bash -lc "$cmd"
}

echo "=== AETHIEA SAVE ==="
echo "message=$MSG"

if [ "$#" -eq 0 ]; then
  echo "paths=."
  run_aegit add .
else
  echo "paths=$*"
  run_aegit add "$@"
fi

echo
echo "=== BAD-PATH CHECK ==="
if run_aegit diff --cached --name-only | grep -E 'node_modules|npm-cache|\.wrangler|wrangler-account|\.token|MODELS/llama|\.gguf|\.uf2|\.img|\.iso|\.pcap|\.pcapng|/builds/|/exports/|/logs/|/images/|sdcard_backups|firmware_cache|\.bin'; then
  echo "BAD PATH STAGED. STOPPING."
  exit 1
else
  echo "STAGED BAD-PATH CLEAN"
fi

echo
echo "=== COMMIT ==="
if run_aegit diff --cached --quiet; then
  echo "nothing staged; working tree likely clean"
else
  run_aegit commit -m "$MSG"
fi

echo
echo "=== PUSH ==="
run_aegit push origin main

echo
echo "=== STATUS ==="
run_aegit status --short
