#!/usr/bin/env bash
set -euo pipefail

AEUSB="/mnt/h/AETHIEAOPSYS"
AEGIT_DIR="$HOME/.aethiea_git/AETHIEAOPSYS.git"

aegit_real() {
  git --git-dir="$AEGIT_DIR" --work-tree="$AEUSB" "$@"
}

if [ "${1:-}" = "" ]; then
  echo "Usage:"
  echo '  aeth-save "Commit message"'
  echo '  aeth-save "Commit message" PATH1 PATH2'
  exit 1
fi

MSG="$1"
shift || true

cd "$AEUSB"

echo "=== AETHIEA SAVE ==="
echo "message=$MSG"

if [ "$#" -eq 0 ]; then
  echo "paths=."
  aegit_real add .
else
  echo "paths=$*"
  aegit_real add "$@"
fi

echo
echo "=== BAD-PATH CHECK ==="
if aegit_real diff --cached --name-only | grep -E 'node_modules|npm-cache|\.wrangler|wrangler-account|\.token|MODELS/llama|\.gguf|\.uf2|\.img|\.iso|\.pcap|\.pcapng|/builds/|/exports/|/logs/|/images/|sdcard_backups|firmware_cache|\.bin'; then
  echo "BAD PATH STAGED. STOPPING."
  exit 1
else
  echo "STAGED BAD-PATH CLEAN"
fi

echo
echo "=== COMMIT ==="
if aegit_real diff --cached --quiet; then
  echo "nothing staged; working tree likely clean"
else
  aegit_real commit -m "$MSG"
fi

echo
echo "=== PUSH ==="
aegit_real push origin main

echo
echo "=== STATUS ==="
aegit_real status --short
