#!/usr/bin/env bash
set -u

ROOT=""
for r in /mnt/[a-z]/AETHIEAOPSYS; do
  if [ -d "$r" ] \
    && [ -f "$r/.aeth_root" ] \
    && [ -f "$r/STATUS.md" ] \
    && [ ! -f "$r/AE320GB_HEAVY_BODY" ] \
    && [ ! -f "$r/.aeth_heavy_body" ]; then
    ROOT="$r"
    break
  fi
done

if [ -z "$ROOT" ]; then
  echo "AEVPS STATUS: authority body not found"
  exit 1
fi

REG="$ROOT/DATA/MEMORY/REGISTRY/aevps_current.md"
BOOT="$ROOT/DATA/BOOT/AEVPS_STARTUP_STATUS.md"

echo "AEVPS STATUS"
echo "==========="
echo "ROOT=$ROOT"
echo

if [ -f "$REG" ]; then
  echo "--- REGISTRY ---"
  sed -n '1,120p' "$REG"
  echo
else
  echo "REGISTRY: missing $REG"
  echo
fi

if [ -f "$BOOT" ]; then
  echo "--- STARTUP ---"
  sed -n '1,120p' "$BOOT"
  echo
else
  echo "STARTUP: missing $BOOT"
  echo
fi

if command -v hcloud >/dev/null 2>&1; then
  echo "--- HCLOUD SERVERS ---"
  hcloud server list 2>/dev/null || true
  echo
fi

if command -v cloudflared >/dev/null 2>&1; then
  echo "--- CLOUDFLARED TUNNELS ---"
  cloudflared tunnel list 2>/dev/null || true
fi
