#!/usr/bin/env bash
# BEGIN AEUSB_DYNAMIC_ROOT_COMPAT
_AEUSB_ROOT="$(aeusb-root 2>/dev/null || true)"
if [ -n "${_AEUSB_ROOT:-}" ]; then
  export AETH_ROOT="${AETH_ROOT:-$_AEUSB_ROOT}"
  export AETHIEA="${AETHIEA:-$AETH_ROOT}"
  export AETHIEAOPSYS="${AETHIEAOPSYS:-$AETH_ROOT}"
  export AEUSB="${AEUSB:-$AETH_ROOT}"
fi

_AEHEAVY_ROOT="$(aeheavy-root 2>/dev/null || true)"
if [ -n "${_AEHEAVY_ROOT:-}" ]; then
  export AEHEAVY_ROOT="${AEHEAVY_ROOT:-$_AEHEAVY_ROOT}"
  export AE320="${AE320:-$_AEHEAVY_ROOT}"
fi

if [ -n "${AETH_ROOT:-}" ] && [ -f "$AETH_ROOT/ENV/SHELL/aethiea_env.sh" ]; then
  . "$AETH_ROOT/ENV/SHELL/aethiea_env.sh" || true
fi
# END AEUSB_DYNAMIC_ROOT_COMPAT
set -euo pipefail

ROOT="${AETH_ROOT:-${AETH_ROOT}}"
if [ -f "$ROOT/ENV/SHELL/aethiea_env.sh" ]; then
  # shellcheck source=${AETH_ROOT}/ENV/SHELL/aethiea_env.sh
  . "$ROOT/ENV/SHELL/aethiea_env.sh"
fi

export WRANGLER_HOME="${WRANGLER_HOME:-$ROOT/.wrangler}"
export CLOUDFLARE_ACCOUNT_ID="${CLOUDFLARE_ACCOUNT_ID:-062cfb070858f437afa2591f462e9cda}"

WORKER_DIR="$ROOT/LAYERS/AENET/CLOUDFLARE/WORKERS/aethernet"
TUNNEL_RUNNER="$ROOT/TOOLIO/cloudflared/run-aethernet"
TUNNEL_LOG="$ROOT/LOGS/cloudflared/AETHERNet.log"
TUNNEL_PID="$ROOT/RUN/cloudflared/AETHERNet.pid"

case "${1:-status}" in
  status)
    echo "cloudflared -> $(command -v cloudflared || true)"
    cloudflared --version 2>/dev/null || true
    echo "wrangler    -> $(command -v wrangler || true)"
    wrangler --version 2>/dev/null || true
    echo "worker_dir  -> $WORKER_DIR"
    if pgrep -f "cloudflared.*AETHERNet.token" >/dev/null 2>&1; then
      echo "AETHERNet   -> RUNNING"
    else
      echo "AETHERNet   -> STOPPED"
    fi
    ;;
  start)
    mkdir -p "$(dirname "$TUNNEL_LOG")"
    nohup "$TUNNEL_RUNNER" > "$TUNNEL_LOG" 2>&1 &
    echo "AETHERNet started -> $!"
    ;;
  stop)
    if [ -s "$TUNNEL_PID" ]; then
      kill "$(cat "$TUNNEL_PID")" 2>/dev/null || true
    fi
    pkill -f "cloudflared.*AETHERNet.token" 2>/dev/null || true
    echo "AETHERNet stopped"
    ;;
  logs)
    tail -n "${2:-80}" "$TUNNEL_LOG" 2>/dev/null || true
    ;;
  info)
    exec cloudflared tunnel info AETHERNet
    ;;
  worker)
    shift
    cd "$WORKER_DIR"
    exec wrangler "$@"
    ;;
  tunnel)
    shift
    exec cloudflared "$@"
    ;;
  *)
    echo "usage: cloudflare-ae [status|start|stop|logs [n]|info|worker <wrangler args...>|tunnel <cloudflared args...>]" >&2
    exit 2
    ;;
esac
