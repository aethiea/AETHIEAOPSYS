#!/usr/bin/env bash
set -euo pipefail

resolve_root() {
  local r
  if command -v aeth_root >/dev/null 2>&1; then
    r="$(aeth_root 2>/dev/null || true)"
    [ -n "$r" ] && [ -d "$r" ] && [ -f "$r/.aeth_root" ] && { printf '%s\n' "$r"; return 0; }
  fi

  for r in "${AETH_ROOT:-}" "${AETHIEA:-}" /mnt/[a-z]/AETHIEAOPSYS /media/*/AETHIEAOPSYS /run/media/*/AETHIEAOPSYS /Volumes/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -d "$r" ] || continue
    [ -f "$r/.aeth_root" ] || continue
    [ -f "$r/STATUS.md" ] || continue
    [ ! -f "$r/AE320GB_HEAVY_BODY" ] || continue
    [ ! -f "$r/.aeth_heavy_body" ] || continue
    printf '%s\n' "$r"
    return 0
  done

  return 1
}

ROOT="$(resolve_root)"
export AETH_ROOT="$ROOT"
export AETHIEA="$ROOT"
export AETHIEAOPSYS="$ROOT"
export AEUSB="$ROOT"

[ -f "$ROOT/ENV/SHELL/aethiea_env.sh" ] && . "$ROOT/ENV/SHELL/aethiea_env.sh" || true

cd "$AETH_ROOT"

echo "AEUSB ROUTED"
echo "Root: $AETH_ROOT"
echo "Host: $(hostname)"
echo "User: $(whoami)"
echo "Timestamp UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "Ollama models: ${OLLAMA_MODELS:-UNSET}"
echo "HF cache: ${HF_HOME:-UNSET}"
