#!/usr/bin/env bash
# BEGIN AEUSB_DYNAMIC_ROOT_COMPAT
_AEUSB_ROOT="$(aeusb-root 2>/dev/null || true)"
if [ -n "${_AEUSB_ROOT:-}" ]; then
  export AETH_ROOT="${AETH_ROOT:-$_AEUSB_ROOT}"
  export AETHIEA="${AETHIEA:-$AETH_ROOT}"
  export AETHIEAOPSYS="${AETHIEAOPSYS:-$AETH_ROOT}"
  export AEUSB="${AEUSB:-$AETH_ROOT}"
fi

_AEHEAVY_ROOT="$(aeheavy-root 2>/dev/null || true)"
if [ -n "${_AEHEAVY_ROOT:-}" ]; then
  export AEHEAVY_ROOT="${AEHEAVY_ROOT:-$_AEHEAVY_ROOT}"
  export AE320="${AE320:-$_AEHEAVY_ROOT}"
fi

if [ -n "${AETH_ROOT:-}" ] && [ -f "$AETH_ROOT/ENV/SHELL/aethiea_env.sh" ]; then
  . "$AETH_ROOT/ENV/SHELL/aethiea_env.sh" || true
fi
# END AEUSB_DYNAMIC_ROOT_COMPAT
set -euo pipefail

cd ${AETH_ROOT}

POLICY="LAYERS/AENET/POLICY/provider_policy.json"

if [[ ! -f "$POLICY" ]]; then
  echo "AENET provider policy missing: $POLICY"
  exit 1
fi

python3 - <<'PY'
import json
from pathlib import Path

policy = json.loads(Path("LAYERS/AENET/POLICY/provider_policy.json").read_text())

print("=== AENET PROVIDER POLICY ===")
print("policy:", policy["policy_name"])
print("version:", policy["version"])
print("default_provider:", policy["default_provider"])
print("default_model:", policy["default_model"])
print()

print("=== PROVIDERS ===")
for name, data in policy["providers"].items():
    print(f"{name}: {data['status']} | {data['role']} | priority {data['priority']}")

print()
print("=== ROUTING RULES ===")
for item in policy["routing_rules"]:
    print("-", item["rule"])
PY
