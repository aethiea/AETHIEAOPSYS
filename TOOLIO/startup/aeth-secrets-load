#!/usr/bin/env bash
# BEGIN AETHIEA_MARKER_RESOLVE
_aeth_resolve_root() {
  local p="${AETHIEA_ROOT:-${AETH_ROOT:-${AETHIEA:-${AETHIEAOPSYS:-$(pwd -P)}}}}"
  if [ -n "$p" ] && [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  p="$(pwd -P)"
  while [ "$p" != "/" ] && [ ! -f "$p/.aeth_root" ]; do p="$(dirname "$p")"; done
  if [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  for p in /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -f "$p/.aeth_root" ] && { (cd "$p" && pwd -P); return; }
  done
  return 1
}
AETHIEA_ROOT="$(_aeth_resolve_root)" || { echo "NO_AETH_ROOT_FOUND"; exit 1; }
export AETHIEA_ROOT AETH_ROOT="$AETHIEA_ROOT" AETHIEA="$AETHIEA_ROOT" AETHIEAOPSYS="$AETHIEA_ROOT"
# END AETHIEA_MARKER_RESOLVE

set -euo pipefail

ROOT="${AETHIEAOPSYS:-$AETHIEA_ROOT}"
SECRET_FILE="$ROOT/VAULT/SECRETS/aethiea.env"
LOG="$ROOT/LOGS/STARTUP/secrets.log"

mkdir -p "$(dirname "$LOG")"

if [[ ! -f "$SECRET_FILE" ]]; then
  echo "$(date -u +%FT%TZ) SECRETS LOAD: MISSING $SECRET_FILE" | tee -a "$LOG"
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$SECRET_FILE"
set +a

check_key() {
  local name="$1"
  local val="${!name:-}"
  if [[ -n "$val" ]]; then
    echo "$(date -u +%FT%TZ) SECRET PRESENT → $name length=${#val}" >> "$LOG"
  else
    echo "$(date -u +%FT%TZ) SECRET MISSING → $name" >> "$LOG"
  fi
}

for k in \
  HCLOUD_TOKEN \
  CLOUDFLARE_API_TOKEN \
  CLOUDFLARE_ACCOUNT_ID \
  CLOUDFLARE_ZONE_ID \
  GITHUB_TOKEN \
  GITLAB_TOKEN \
  HF_TOKEN \
  OPENAI_API_KEY \
  OPENROUTER_API_KEY \
  RUNPOD_API_KEY \
  ORACLE_CLOUD_CONFIG_FILE \
  AWS_PROFILE
do
  check_key "$k"
done

echo "$(date -u +%FT%TZ) SECRETS LOAD: COMPLETE — values not printed" | tee -a "$LOG"
