#!/usr/bin/env bash
set -e

resolve_root() {
  local r d

  if command -v aeth_root >/dev/null 2>&1; then
    r="$(aeth_root 2>/dev/null || true)"
    [ -n "$r" ] && [ -d "$r" ] && [ -f "$r/.aeth_root" ] && { printf '%s\n' "$r"; return 0; }
  fi

  for r in "${AETH_ROOT:-}" "${AETHIEA:-}" "${AETHIEAOPSYS:-}" "${AEUSB:-}"; do
    [ -n "$r" ] && [ -d "$r" ] && [ -f "$r/.aeth_root" ] && { printf '%s\n' "$r"; return 0; }
  done

  d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/.aeth_root" ] && { printf '%s\n' "$d"; return 0; }
    d="$(dirname "$d")"
  done

  for r in /mnt/[a-z]/AETHIEAOPSYS /media/*/AETHIEAOPSYS /run/media/*/AETHIEAOPSYS /Volumes/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -d "$r" ] || continue
    [ -f "$r/.aeth_root" ] || continue
    [ -f "$r/STATUS.md" ] || continue
    [ ! -f "$r/AE320GB_HEAVY_BODY" ] || continue
    [ ! -f "$r/.aeth_heavy_body" ] || continue
    printf '%s\n' "$r"
    return 0
  done

  return 1
}

AETH_ROOT="$(resolve_root)"
export AETH_ROOT
export AETHIEA="$AETH_ROOT"

cmd="${1:-status-surface}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  up|start)
    exec bash "$AETH_ROOT/TOOLIO/aeth-up" "$@"
    ;;

  down|stop)
    exec bash "$AETH_ROOT/TOOLIO/aeth-down" "$@"
    ;;

  status-surface|surface-status)
    exec bash "$AETH_ROOT/TOOLIO/aeth-status" "$@"
    ;;

  door|aenet)
    exec bash "$AETH_ROOT/TOOLIO/aenet-door" "$@"
    ;;

  mistral)
    exec bash "$AETH_ROOT/TOOLIO/aenet-door" ask --model mistral "$@"
    ;;

  llama)
    exec bash "$AETH_ROOT/TOOLIO/aenet-door" ask --model llama "$@"
    ;;

  *)
    exec python3 "$AETH_ROOT/CORE/aeth.py" "$cmd" "$@"
    ;;
esac
