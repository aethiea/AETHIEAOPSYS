#!/usr/bin/env bash
# BEGIN AETHIEA_MARKER_RESOLVE
_aeth_resolve_root() {
  local p="${AETHIEA_ROOT:-${AETH_ROOT:-${AETHIEA:-${AETHIEAOPSYS:-$(pwd -P)}}}}"
  if [ -n "$p" ] && [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  p="$(pwd -P)"
  while [ "$p" != "/" ] && [ ! -f "$p/.aeth_root" ]; do p="$(dirname "$p")"; done
  if [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  for p in /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -f "$p/.aeth_root" ] && { (cd "$p" && pwd -P); return; }
  done
  return 1
}
AETHIEA_ROOT="$(_aeth_resolve_root)" || { echo "NO_AETH_ROOT_FOUND"; exit 1; }
export AETHIEA_ROOT AETH_ROOT="$AETHIEA_ROOT" AETHIEA="$AETHIEA_ROOT" AETHIEAOPSYS="$AETHIEA_ROOT"
# END AETHIEA_MARKER_RESOLVE


if [ -f ${AETHIEA_ROOT}/ENV/SHELL/aethiea_env.sh ]; then
  # shellcheck source=/dev/null
  . ${AETHIEA_ROOT}/ENV/SHELL/aethiea_env.sh
else
  export AETHIEA="${AETHIEA:-$AETHIEA_ROOT}"
  export AETH_ROOT="${AETH_ROOT:-$AETHIEA}"
  export AETHIEA_MODE="${AETHIEA_MODE:-USB_NATIVE_ROUTED}"
  export AETHIEA_SURFACE="${AETHIEA_SURFACE:-$(hostname)}"
fi

echo "=== AETHIEA SURFACE STATUS ==="
echo "HOST      -> $(hostname)"
echo "USER      -> $(whoami)"
echo "SURFACE   -> $AETHIEA_SURFACE"
echo "MODE      -> $AETHIEA_MODE"
echo "ROOT      -> $AETHIEA"
echo "AETH_ROOT -> $AETH_ROOT"
echo "OLLAMA    -> ${OLLAMA_MODELS:-UNSET}"
echo "HF_HOME   -> ${HF_HOME:-UNSET}"

test -d "$AETHIEA" && echo "ROOT DIR  -> OK" || echo "ROOT DIR  -> FAIL"
test -f "$AETHIEA/.aeth_root" && echo "ROOT MARK -> OK" || echo "ROOT MARK -> FAIL"

echo "AETH CMD  -> $(command -v aeth || echo FAIL)"
aeth status || true
aeusb-route-check || true

echo "=== END STATUS ==="
