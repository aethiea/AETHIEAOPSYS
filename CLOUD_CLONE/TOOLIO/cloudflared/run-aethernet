#!/usr/bin/env bash
# BEGIN AETHIEA_MARKER_RESOLVE
_aeth_resolve_root() {
  local p="${AETHIEA_ROOT:-${AETH_ROOT:-${AETHIEA:-${AETHIEAOPSYS:-$(pwd -P)}}}}"
  if [ -n "$p" ] && [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  p="$(pwd -P)"
  while [ "$p" != "/" ] && [ ! -f "$p/.aeth_root" ]; do p="$(dirname "$p")"; done
  if [ -f "$p/.aeth_root" ]; then (cd "$p" && pwd -P); return; fi
  for p in /mnt/*/AETHIEAOPSYS "$HOME/AETHIEAOPSYS" /opt/AETHIEAOPSYS; do
    [ -f "$p/.aeth_root" ] && { (cd "$p" && pwd -P); return; }
  done
  return 1
}
AETHIEA_ROOT="$(_aeth_resolve_root)" || { echo "NO_AETH_ROOT_FOUND"; exit 1; }
export AETHIEA_ROOT AETH_ROOT="$AETHIEA_ROOT" AETHIEA="$AETHIEA_ROOT" AETHIEAOPSYS="$AETHIEA_ROOT"
# END AETHIEA_MARKER_RESOLVE

set -euo pipefail

ROOT="${AETH_ROOT:-$AETHIEA_ROOT}"
if [ -f "$ROOT/ENV/SHELL/aethiea_env.sh" ]; then
  # shellcheck source=/dev/null
  . "$ROOT/ENV/SHELL/aethiea_env.sh"
fi

TOKEN_FILE="$ROOT/TOOLIO/cloudflared/AETHERNet.token"
CONFIG_FILE="$ROOT/TOOLIO/cloudflared/AETHERNet.yml"
LOG_DIR="$ROOT/LOGS/cloudflared"
PID_FILE="$ROOT/RUN/cloudflared/AETHERNet.pid"

if [ ! -s "$TOKEN_FILE" ]; then
  echo "missing tunnel token file: $TOKEN_FILE" >&2
  exit 1
fi

mkdir -p "$LOG_DIR" "$(dirname "$PID_FILE")"

exec "$ROOT/TOOLIO/bin/cloudflared" \
  --config "$CONFIG_FILE" \
  --no-autoupdate \
  --pidfile "$PID_FILE" \
  --logfile "$LOG_DIR/AETHERNet.cloudflared.log" \
  tunnel run \
  --token-file "$TOKEN_FILE"
