#!/usr/bin/env python3
import os, sys, json
from pathlib import Path
from datetime import datetime, timezone
from openai import OpenAI

def _resolve_aeth_root():
    for val in (os.environ.get("AETH_ROOT"), os.environ.get("AETHIEA_ROOT"), os.environ.get("AETHIEA"), os.environ.get("AETHIEAOPSYS")):
        if val and (Path(val) / ".aeth_root").exists():
            return Path(val).resolve()
    p = Path.cwd().resolve()
    for q in (p, *p.parents):
        if (q / ".aeth_root").exists():
            return q
    for q in list(Path("/mnt").glob("*/AETHIEAOPSYS")) + [Path.home() / "AETHIEAOPSYS", Path("/opt/AETHIEAOPSYS")]:
        if (q / ".aeth_root").exists():
            return q.resolve()
    raise SystemExit("NO_AETH_ROOT_FOUND")

AETH_ROOT = _resolve_aeth_root()
LOG_DIR = AETH_ROOT / "LOGS" / "CHAT"
LOG_DIR.mkdir(parents=True, exist_ok=True)

prompt = " ".join(sys.argv[1:]).strip()
if not prompt:
    prompt = input("AE ask > ")

client = OpenAI(api_key=os.environ["OPENAI_API_KEY"])

r = client.responses.create(
    model=os.environ.get("OPENAI_MODEL", "gpt-5.5"),
    input=prompt
)

text = r.output_text
print(text)

stamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
with open(LOG_DIR / f"{stamp}_openai.json", "w") as f:
    json.dump({
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "provider": "openai",
        "model": os.environ.get("OPENAI_MODEL", "gpt-5.5"),
        "prompt": prompt,
        "response": text
    }, f, indent=2)
