{
  "policy": "AEHUB_DOMAIN_ZONE_BOUNDARY",
  "version": "1.0.3",
  "mode": "PERPETUAL_NONBLOCKING_AUDIT",
  "mutations": {
    "dns": false,
    "cloudflare": false,
    "tunnels": false,
    "credentials": false,
    "certificates": false,
    "keys": false
  },
  "zones": {
    "thematriculation.cc": {
      "valid": true,
      "role": "MATRICULATION_PUBLIC_CORPUS_AND_AENET_ROUTE_ZONE",
      "routes": {
        "public_corpus_and_network": [
          "thematriculation.cc",
          "aethieaopsys.thematriculation.cc",
          "aethernet.thematriculation.cc",
          "aenet.thematriculation.cc",
          "aether.thematriculation.cc"
        ],
        "bounded_authorized_routes": [
          "ssh.thematriculation.cc"
        ],
        "pending_verification_routes": [
          "labelle.thematriculation.cc"
        ]
      }
    },
    "aethiea.net": {
      "valid": true,
      "role": "AETHIEA_INFRASTRUCTURE_AND_SERVICE_NAMESPACE",
      "routes": [
        "aethiea.net",
        "hub.aethiea.net",
        "status.aethiea.net",
        "api.aethiea.net",
        "aenet.aethiea.net",
        "aethernet.aethiea.net",
        "rubiii.aethiea.net",
        "rubiii-status.aethiea.net",
        "aethvnas.aethiea.net",
        "vrag.aethiea.net",
        "scrapegpt.aethiea.net",
        "aevps.aethiea.net"
      ]
    }
  },
  "forbidden_patterns": [
    "*.aethiea.net.thematriculation.cc"
  ],
  "historical_repair_evidence": [
    "CONFIG/network/cloudflare-door-dns-conflict-repair-v2.json"
  ],
  "invariants": [
    "thematriculation.cc remains valid.",
    "aethiea.net remains valid.",
    "The zones remain separate.",
    "Historical repair evidence is not an active route.",
    "Cloudflare routes but does not own the corpus.",
    "AEHUB conducts but does not become the body.",
    "Separation with coordination.",
    "Symbiosis, not assimilation.",
    "DON'T MINGLE."
  ],
  "active_route_sources": [
    "CONFIG/network/aethiea-net-hub-dns.json",
    "CONFIG/network/cloudflare-door-normalization-v1.json",
    "LAYERS/AENET/CONFIG/cloudflare_routes.json",
    "LAYERS/AENET/CLOUDFLARE/WORKERS/aethernet/worker_route.json",
    "CONFIG/network/aevps-cloudflared-route-truth.json"
  ],
  "route_detection": {
    "mode": "STRUCTURED_JSON_OPERATIONAL_CONTEXT",
    "prose_and_denial_context_excluded": true,
    "historical_repair_evidence_excluded": true,
    "active_mixed_suffix_routes_fail_boundary": true
  },
  "aevps_runtime_route_observation": {
    "current_observation_map": "CONFIG/network/aevps-cloudflared-route-truth.json",
    "route_authority_surface": "AEUSB",
    "executor_surface": "AEVPS",
    "live_tunnel_is_distinct_from_rubiii_route_records": true
  }
}
