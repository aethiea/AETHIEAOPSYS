
# === AETHIEA GITLAB SSH ROUTE ===
Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/aethieaos_gitlab_ed25519
  IdentitiesOnly yes
  AddKeysToAgent yes
# === END AETHIEA GITLAB SSH ROUTE ===
# BEGIN AEVPS-001
Host aevps-001
  HostName 5.161.63.237
  User root
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
# END AEVPS-001
